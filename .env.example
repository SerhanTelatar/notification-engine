# notification-engine configuration. Copy to .env; every value below is the default.
# All configuration is read from environment variables (Constitution VIII). No secrets live in
# the repository: the credentials below are local docker-compose defaults only.

# --- Shared ---------------------------------------------------------------------------------
DATABASE_URL=postgres://notify:notify@postgres:5432/notify?sslmode=disable
REDIS_ADDR=redis:6379
LOG_LEVEL=info                       # debug | info | warn | error
SHUTDOWN_TIMEOUT=20s
OTEL_EXPORTER_OTLP_ENDPOINT=         # empty = tracing off (bonus)

# --- API (cmd/api) --------------------------------------------------------------------------
HTTP_ADDR=:8080
MAX_ATTEMPTS=5                       # stamped on each notification at creation

# --- Worker (cmd/worker) --------------------------------------------------------------------
OPS_ADDR=:9090                       # /healthz, /readyz, /metrics
AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# Provider (webhook.site in demos: https://webhook.site/<uuid>)
PROVIDER_URL=http://mockprovider:8090/send
PROVIDER_TIMEOUT=5s

# Throughput and retry
RATE_LIMIT_PER_SECOND=100            # per channel, across all workers
RATE_LIMIT_SEND_OFFSET=50ms          # provider calls start at their slot + this (covers the claim)
RATE_LIMIT_HEADROOM=0.05             # space slots 5% wider than 1s/limit: absorbs jitter (~95/s)
LIMITER_MAX_WAIT=30s                 # then the message is requeued
BACKOFF_BASE=1s
BACKOFF_MAX=5m

# Circuit breaker (per channel)
BREAKER_CONSECUTIVE_FAILURES=5
BREAKER_COOLDOWN=30s
BREAKER_MAX_DEFER_AGE=1h             # older deferred notifications fail as provider_unavailable

# Outbox relay
RELAY_INTERVAL=200ms
RELAY_BATCH_SIZE=500
RELAY_MAX_INFLIGHT_PER_CHANNEL=1000  # backpressure: cap on queued rows per channel

# Consumers
CONSUMER_CONCURRENCY_PER_CHANNEL=20

# Crash recovery
REAPER_INTERVAL=30s
REAPER_SENDING_TIMEOUT=2m
REAPER_QUEUED_TIMEOUT=15m
